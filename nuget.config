<?xml version="1.0" encoding="utf-8"?>
<!--
  Sits at the root of the solution (next to GiftOfTheGivers.Solution.sln). It tells
  `dotnet restore` and NuGet to look at the project's Azure Artifacts feed, as well as
  nuget.org, when resolving the GiftOfTheGivers.Helpers package (Section D.2).

  Feed created in Section D.1:
    Organisation : ST10448224
    Project      : GiftOfTheGivers-Relief
    Feed         : GiftOfTheGivers-Packages  (project-scoped)

  Authentication:
    * Azure Pipelines  - handled by the NuGetAuthenticate@1 task in azure-pipelines.yml,
                         using the pipeline's own build-service identity. Nothing secret
                         is stored in this file or in the repository.
    * Visual Studio    - prompts to sign in interactively on the first restore.
    * Command line     - set the AZURE_ARTIFACTS_PAT environment variable to a Personal
                         Access Token with Packaging (Read) scope. It is read below via
                         an environment-variable reference, so the token itself is never
                         committed.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="GiftOfTheGivers-Artifacts" value="https://pkgs.dev.azure.com/ST10448224/GiftOfTheGivers-Relief/_packaging/GiftOfTheGivers-Packages/nuget/v3/index.json" />
  </packageSources>

  <!-- Restrict the private feed to this project's own package, so every other dependency
       is still resolved from nuget.org and cannot be shadowed by the private feed. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="GiftOfTheGivers-Artifacts">
      <package pattern="GiftOfTheGivers.*" />
    </packageSource>
  </packageSourceMapping>

  <packageSourceCredentials>
    <GiftOfTheGivers-Artifacts>
      <add key="Username" value="AzureDevOps" />
      <add key="ClearTextPassword" value="%AZURE_ARTIFACTS_PAT%" />
    </GiftOfTheGivers-Artifacts>
  </packageSourceCredentials>
</configuration>
