<?xml version="1.0" encoding="utf-8"?>
<!--
  Place this file at the root of the Visual Studio solution (next to the .sln file), alongside
  GiftOfTheGiversApp.csproj. It tells `dotnet restore` / NuGet in Visual Studio to also look at
  your Azure Artifacts feed when resolving the GiftOfTheGivers.Helpers package (Section D.2).

  Replace ORG and FEED below with your own Azure DevOps organisation and feed names, e.g. the
  feed created in Section D.1 (see setup-guide.md for the exact `az artifacts` / portal steps).
  The feed URL format for a project-scoped feed is:
    https://pkgs.dev.azure.com/{organisation}/{project}/_packaging/{feed}/nuget/v3/index.json
-->
<configuration>
  <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
        <!-- The Azure Artifacts feed is intentionally left here as a template. For local runs
          where authentication to the private feed is unavailable, remove or comment out
          the line below so `dotnet restore` uses only nuget.org. Replace ORG/FEED when
          publishing to Azure and restore with proper credentials. -->
        <!-- <add key="GiftOfTheGivers-Artifacts" value="https://pkgs.dev.azure.com/ORG/GiftOfTheGivers-Relief/_packaging/FEED/nuget/v3/index.json" /> -->
  </packageSources>
  <packageSourceCredentials>
    <GiftOfTheGivers-Artifacts>
      <!-- In Visual Studio you will instead be prompted to sign in interactively the first
           time you restore; these two lines are only needed for command-line / pipeline
           restores using a Personal Access Token (PAT) with Packaging (Read) scope. -->
      <add key="Username" value="AzureDevOps" />
      <add key="ClearTextPassword" value="%AZURE_ARTIFACTS_PAT%" />
    </GiftOfTheGivers-Artifacts>
  </packageSourceCredentials>
</configuration>
