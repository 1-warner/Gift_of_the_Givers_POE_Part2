@model GiftOfTheGiversApp.Models.Donation
@{
    ViewData["Title"] = "Donate";
    var projects = ViewBag.Projects as List<GiftOfTheGiversApp.Models.ReliefProject> ?? new();
}
<div class="row">
    <div class="col-lg-7">
        <h1 class="text-gotg">Make a donation</h1>
        <p class="text-muted">One-time or recurring. Values are symbolic at this prototype stage. You can donate as a
            registered donor or as an anonymous guest &mdash; a placeholder tax certificate is generated either way.</p>

        <form asp-action="Index" method="post" class="card gotg-card p-4">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            @if (User.Identity?.IsAuthenticated != true)
            {
                <div class="mb-3">
                    <label class="form-label">Your name (optional &mdash; leave blank to give anonymously)</label>
                    <input asp-for="DonorName" class="form-control" placeholder="Anonymous Guest" />
                </div>
            }

            <div class="row">
                <div class="col-sm-6 mb-3">
                    <label asp-for="Amount" class="form-label">Amount</label>
                    <input asp-for="Amount" class="form-control" type="number" step="0.01" min="1" value="100" />
                    <span asp-validation-for="Amount" class="text-danger"></span>
                </div>
                <div class="col-sm-6 mb-3">
                    <label asp-for="Currency" class="form-label">Currency</label>
                    <select asp-for="Currency" class="form-select">
                        <option value="ZAR">ZAR — South African Rand</option>
                        <option value="USD">USD — US Dollar</option>
                        <option value="EUR">EUR — Euro</option>
                    </select>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label d-block">Donation type</label>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" asp-for="Frequency" value="OneTime" id="oneTime" checked />
                    <label class="form-check-label" for="oneTime">One-time</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" asp-for="Frequency" value="Recurring" id="recurring" />
                    <label class="form-check-label" for="recurring">Recurring (monthly)</label>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="ProjectId" class="form-label">Relief project (optional)</label>
                <select asp-for="ProjectId" class="form-select">
                    <option value="">General fund</option>
                    @foreach (var p in projects)
                    {
                        <option value="@p.ProjectId">@p.Name — @p.Location</option>
                    }
                </select>
            </div>

            <button type="submit" class="btn btn-gotg btn-lg">Donate &amp; get tax certificate</button>
        </form>
    </div>
    <div class="col-lg-5">
        <div class="alert alert-secondary mt-5">
            <h6 class="text-gotg">Prototype note</h6>
            No real payment is taken. Submitting records a dummy donation and immediately issues a placeholder
            tax certificate you can view and download as a PDF.
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
