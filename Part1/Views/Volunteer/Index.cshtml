@model GiftOfTheGiversApp.Models.Volunteer
@{
    ViewData["Title"] = "Volunteer";
}
<div class="row justify-content-center">
    <div class="col-lg-7">
        <h1 class="text-gotg">Register as a volunteer</h1>
        <p class="text-muted">Tell us who you are, what you can do and when you are available. The Foundation will
            reach out when your skills are needed.</p>

        <form asp-action="Index" method="post" class="card gotg-card p-4">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label"></label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Skills" class="form-label"></label>
                <input asp-for="Skills" class="form-control" placeholder="e.g. First aid, driving, cooking" />
            </div>
            <div class="mb-3">
                <label asp-for="Availability" class="form-label"></label>
                <input asp-for="Availability" class="form-control" placeholder="e.g. Weekends, evenings, on call" />
            </div>
            <button type="submit" class="btn btn-gotg btn-lg">Submit</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
